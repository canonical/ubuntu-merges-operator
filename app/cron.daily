# along with this program.  If not, see <http://www.gnu.org/licenses/>.

set -e
umask 002

MOMLIB_ROOT="/srv/merges"

if [ "$DEBUG" = "y" ]; then
	QUIET=""
else
	QUIET="-q"

	# Lock held by the kernel on the open file descriptor, released
	# however the script exits so a killed run can't leave it stale
	exec 9>"$MOMLIB_ROOT"/cron.lock
	if ! flock -n 9; then
		# Only complain if running from a terminal
		if [ -t 0 ]; then
			echo "LOCKED (another one running?)"
			exit 1
		fi
		exit 0
	fi
fi

cd "$MOMLIB_ROOT"/code

# Resolve the Ubuntu development series once so every script in this run
# agrees on it, even if Launchpad flips the current series mid-run
if [ -z "$MOM_OUR_DIST" ]; then
	MOM_OUR_DIST="$(python3 -c 'from momlib import get_our_dist; print(get_our_dist())')"
fi
export MOM_OUR_DIST

mkdir -p "$MOMLIB_ROOT"/merges/.static
mkdir -p "$MOMLIB_ROOT"/published/.static
cp -a static/* "$MOMLIB_ROOT"/merges/.static
cp -a static/* "$MOMLIB_ROOT"/published/.static
cp -a addcomment.psp "$MOMLIB_ROOT"/merges

# Include header with the instructions
cp data/HEADER-merges.html "$MOMLIB_ROOT"/merges/HEADER.html
cp data/HEADER-patches.html "$MOMLIB_ROOT"/published/HEADER.html

# Provides a robots.txt to try to lower bots activity
cp data/robots.txt "$MOMLIB_ROOT"/merges/
cp data/robots.txt "$MOMLIB_ROOT"/published/

# Site icon, browsers look for it at the root without needing a link
cp data/favicon.ico "$MOMLIB_ROOT"/merges/
cp data/favicon.ico "$MOMLIB_ROOT"/published/

# Fetch a file into $MOMLIB_ROOT, keeping the previous copy if the download
# fails so that a network glitch doesn't abort the whole run
fetch () {
	local url="$1" dest="$MOMLIB_ROOT/$2"
	if wget -nv --timeout=30 --tries=3 -O"$dest.new" "$url"; then
		mv "$dest.new" "$dest"
	else
		echo "WARNING: failed to download $url (wget exit $?), keeping previous copy" >&2
		rm -f "$dest.new"
	fi
}

# Update the blocklist
fetch https://static-reports.ubuntu.com/sync-blocklist.txt sync-blocklist.txt

# Update the package to team mapping
fetch https://static-reports.ubuntu.com/package-team-mapping.json package-team-mapping.json

# Download new packages
./update-pool.py $QUIET debian ubuntu

# Update the Sources files against new packages that have been downloaded.
./update-sources.py $QUIET

# Generate changes, diffs and patches
./generate-diffs.py $QUIET
./generate-patches.py $QUIET
./generate-dpatches.py $QUIET

# Publish the Ubuntu patches so that Debian people can get at them
./publish-patches.py $QUIET
# That script gets killed everytime, and not sure it's really needed
# ./syndicate.py $QUIET

# Run the merge tool
./produce-merges.py $QUIET -X data/merge-blocklist.txt -X data/experimental.txt -X data/unstable.txt -X data/testing-proposed-updates.txt
./produce-merges.py $QUIET -X data/merge-blocklist.txt -I data/experimental.txt -X data/unstable.txt -X data/testing-proposed-updates.txt -S experimental
./produce-merges.py $QUIET -X data/merge-blocklist.txt -X data/experimental.txt -I data/unstable.txt -X data/testing-proposed-updates.txt -S unstable
./produce-merges.py $QUIET -X data/merge-blocklist.txt -X data/experimental.txt -X data/unstable.txt -I data/testing-proposed-updates.txt -S testing-proposed-updates

# Produce pretty reports
./stats.py $QUIET
./stats.py $QUIET -t ubuntu-server
./stats.py $QUIET -t foundations-bugs -E data/foundations.exclude
./stats.py $QUIET -t ubuntu-openstack
./stats-graphs.py $QUIET
./merge-status.py $QUIET

# Expire any old packages from the pool
./expire-pool.py $QUIET

# ?! untidy
rm -rf "$MOMLIB_ROOT"/unpacked/*
